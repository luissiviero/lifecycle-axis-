# Sourced by hooks and scripts. Space-separated lists. Humans edit this via PR; agents cannot.

# Code paths that require an approved plan.md before an agent may edit them.
PLAN_REQUIRED_PATHS="scripts"

# Paths an agent may never edit: the control plane, plus the files that make up the verify loop
# (settings, verify.sh, the two runners, scripts/checks/) so an agent cannot weaken the check on
# its own work (work/loop-protection). File entries match as is; directories cover their trees.
PROTECTED_PATHS=".claude/hooks .github/workflows .sdlc .gemini .claude/settings.json scripts/verify.sh scripts/run_tests.py scripts/run_evals.sh scripts/checks"

# Paths whose changes always need a named human approver in the PR (see REVIEW.md).
RELEASE_GATED_PATHS="migrations infra terraform helm"

# Generated paths: excluded from review findings (edit the fragments in docs/sdlc/rules or the
# generators, never these outputs).
GENERATED_PATHS="src/gen CLAUDE.md GEMINI.md AGENTS.md work/index.md work/*/index.md"

# Test-file globs (bash patterns). When the active plan has kind: fix, agents may not edit these.
TEST_FILE_GLOBS="*_test.* *.test.* *_spec.* *.spec.* test_*.py tests/* test/* __tests__/* evals/cases/*"

# Optional formatter run after every agent edit; receives the file path as $1. Empty = disabled.
FORMAT_CMD=""

# Commands run by scripts/verify.sh, separated by ';'. All must exit 0.
VERIFY_CMDS="python3 scripts/run_tests.py; python3 scripts/check_artifact_chain.py --base HEAD; scripts/run_evals.sh"

# Path to the approvers/roles file used to validate `approved-by` in chain artifacts.
APPROVERS_FILE=".sdlc/approvers.yaml"

# Directories scanned by the OKF conformance checker.
KNOWLEDGE_PATHS="knowledge docs/sdlc"

# When "1", the OKF conformance check fails the build on warnings; otherwise it only warns.
OKF_STRICT="0"

# Context files generated from the shared rule source in RULES_SRC.
CONTEXT_FILES="CLAUDE.md GEMINI.md AGENTS.md"

# Directory of rule fragments rendered into each file in CONTEXT_FILES.
RULES_SRC="docs/sdlc/rules"

# PR label that exempts a control-plane diff from the automated block (human-applied only).
CONTROL_PLANE_LABEL="control-plane-approved"

# Head-branch prefixes CI treats as agent-authored in scripts/check_control_plane.sh (a Bot author
# or a Claude commit trailer counts too). Humans use work/<slug>, which stays off this list.
AGENT_BRANCH_PREFIXES="claude/ kit/ spike/"

# When "1", protect-paths.sh also inspects Bash commands for writes to protected paths.
BASH_WRITE_GUARD="1"

# Maximum line count allowed in each generated context file.
MAX_CONTEXT_LINES="120"

