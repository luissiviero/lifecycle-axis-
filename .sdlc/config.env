# Sourced by hooks and scripts. Space-separated lists. Edit via PR only.

# Code paths that require an approved plan.md before an agent may edit them.
PLAN_REQUIRED_PATHS="src lib app services packages"

# Paths an agent may never edit (humans edit these via PR).
PROTECTED_PATHS=".claude/hooks .github/workflows .sdlc"

# Paths whose changes always need a named human approver in the PR (see REVIEW.md).
RELEASE_GATED_PATHS="migrations infra terraform helm"

# Bash commands (regex, one per line in production-gate.sh) are matched in the hook.

# Commands run by scripts/verify.sh, in order. All must exit 0.
VERIFY_CMDS="echo 'no verify commands configured yet — set VERIFY_CMDS in .sdlc/config.env'"
